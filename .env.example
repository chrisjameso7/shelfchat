# Set these in the deployment environment. Node does not automatically load this file.
PORT=3001
DATA_DIR=./data
NODE_ENV=production
# Set only when behind exactly this many trusted reverse proxies.
# TRUST_PROXY=1

# Vercel production only. Set through connected storage integrations.
# DATABASE_URL=
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_HOSTNAME=

# Optional: pause JIT source lookups without affecting local catalog search
CATALOG_LOOKUPS_ENABLED=1
# Protect database headroom; this is a worker guard, not the provider billing limit
CATALOG_STORAGE_BUDGET_MB=750
