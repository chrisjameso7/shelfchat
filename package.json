{
  "name": "shelfchat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js cloud/*.test.js",
    "db:setup": "node cloud/setup.js",
    "vercel-build": "npm run db:setup && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vercel/blob": "2.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
